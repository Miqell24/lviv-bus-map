{
  "name": "lviv-bus-map",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Interactive map of Lviv public transport (55 bus, 9 trolleybus, 8 tram lines) — Lvivavtodor GTFS + OSM + HMM map matching",
  "scripts": {
    "download": "bash pipeline/download.sh",
    "build": "node --max-old-space-size=6144 pipeline/build.mjs --all --tram all",
    "lines": "node --max-old-space-size=6144 pipeline/lines.mjs",
    "report": "node pipeline/report-gaps.mjs",
    "audit": "node --max-old-space-size=6144 pipeline/audit.mjs",
    "serve": "node pipeline/serve.mjs 8175"
  }
}
